type EmailName = repeat (
    letters
    | digits
    | "."
    | "_"
    | "%"
    | "+"
    | "-"
) 1 to unlimited

type SubDomain = repeat (
    letters
    | digits
    | "-"
) 1 to unlimited

type Domain = repeat (
    "." SubDomain
) 1 to unlimited

pattern EmailAddress {
    EmailName "@" SubDomain Domain
}
